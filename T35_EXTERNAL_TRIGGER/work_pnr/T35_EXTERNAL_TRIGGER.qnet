	name: "n4286"
	terminal	{ cell: "LUT__6411" port: "O" }
	terminal	{ cell: "LUT__6412" port: "I[2]" }
 }
net {
	name: "sysclk~CLKBUF"
	type: GLOBAL_CLOCK
	gbuf_driven: true
	terminal	{ cell: "sysclk~CLKBUF" port: "clkout" }
 }
